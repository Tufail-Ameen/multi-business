# FILL THIS FILE → save as .env (same folder)
# Copy: cp .env.example .env   then edit .env

# >>> REQUIRED: apna MongoDB URI yahan paste karo <<<
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_URI=REPLACE_WITH_YOUR_MONGODB_URI
MONGODB_DB=InvoiceApp

# --- Integration tests (optional) ---
# Prefer a dedicated Atlas/local URI for tests. When set, binaries are NOT downloaded.
# TEST_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
# Isolated DB name MUST include "test" (never use InvoiceApp / production names).
# TEST_MONGODB_DB=business_erp_test
# If neither TEST_MONGODB_URI nor a reachable MONGODB_URI is set, tests fall back to mongodb-memory-server.

# Local: 5001 (CRA proxy). Render/Railway PORT khud set karte hain — yahan mat hardcode.
PORT=5001
HOST=0.0.0.0
# Local: http://localhost:3000
# Render: Vercel frontend URL, e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Optional ecommerce auth server
ECOMMERCE_PORT=5002

# >>> REQUIRED: apni JWT secrets (koi bhi lambi random string) <<<
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=604800

# Platform admin (optional: npm run seed:platform-admin)
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
